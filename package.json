{
  "name": "openshield-africa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "api": "node server/index.js",
    "db:migrate": "node scripts/migrate.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "smtp:verify": "node scripts/check-smtp.js",
    "outbox:run": "node scripts/outbox-worker.js",
    "outbox:daemon": "node scripts/outbox-daemon.js",
    "reassess:run": "node scripts/reassessment-worker.js",
    "staging:verify": "node scripts/verify-private-staging.js",
    "release:preflight": "node scripts/release-preflight.js",
    "staging:preflight": "node scripts/staging-preflight.js"
  },
  "dependencies": {
    "vite": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.1",
    "nodemailer": "^6.10.1"
