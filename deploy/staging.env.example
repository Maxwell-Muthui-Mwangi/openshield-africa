# Private staging only. Never commit credentials.
# Copy to /etc/openshield/staging.env with chmod 0600 and owner openshield.
NODE_ENV=staging
APP_ORIGIN=https://staging.example.invalid
COOKIE_SECURE=true
REGISTRATION_ENABLED=false
PUBLIC_SCAN_ENABLED=false
LOCAL_SCAN_ENABLED=false
ORGANIZATIONS_ENABLED=true
REASSESSMENT_WORKER_ENABLED=false
OUTBOX_WORKER_ENABLED=false
STAGING_VERIFY_ENABLED=false
DATABASE_URL=
DATABASE_SSL=require
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
