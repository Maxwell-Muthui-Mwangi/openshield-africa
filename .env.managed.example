# Managed PostgreSQL connection template. Supply credentials securely.
DB_MODE=managed
DATABASE_URL=postgresql://USER:REPLACE_WITH_PASSWORD@YOUR_MANAGED_DB_HOST:5432/openshield
DATABASE_SSL=require
DB_POOL_MAX=5
# Keep local app origin while testing managed DB from localhost.
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
PORT=8787
# For a production HTTPS app, set COOKIE_SECURE=true and APP_ORIGIN=https://your-app.example

# Local registration only. Keep disabled in publicly reachable environments.
REGISTRATION_ENABLED=false

# SMTP email delivery (server-side secrets only)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
MAIL_FROM=OpenShield Africa <no-reply@example.org>

# Server-only encrypted email outbox key; 64 hex characters from a secure random generator
OUTBOX_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
OUTBOX_WORKER_ENABLED=false
