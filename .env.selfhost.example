# Copy values to your shell environment; never commit a real .env file.
DB_MODE=self-hosted
DATABASE_URL=postgresql://openshield:REPLACE_ME@127.0.0.1:5432/openshield
DATABASE_SSL=disable
DB_POOL_MAX=5
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
PORT=8787

# Local registration only. Keep disabled in publicly reachable environments.
REGISTRATION_ENABLED=false
